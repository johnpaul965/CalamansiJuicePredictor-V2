#!/usr/bin/env python3
"""
Calamansi Yield Prediction - Live Model Training & Evaluation Script
Leyte Normal University - Tacloban City Calamansi Harvest Study

Trains 3 Weight-Only Models directly from dataset.csv:
  1. Simple Linear Regression (SLR Baseline)
  2. Polynomial Regression Degree 2 (Quadratic Baseline - No Size)
  3. Proposed Model: Polynomial (d=2) + ln(W) & L2 Ridge Regularization
"""

import csv
import json
import math
import os

DATASET_FILE = 'dataset.csv'
OUTPUT_METRICS_FILE = 'model_metrics.json'

def load_and_clean_dataset(filepath):
    if not os.path.exists(filepath):
        raise FileNotFoundError(f"Dataset file '{filepath}' not found.")
    
    raw_rows = []
    with open(filepath, 'r', encoding='utf-8') as f:
        reader = csv.DictReader(f)
        for row in reader:
            raw_rows.append((float(row['Weight']), float(row['Juice'])))
    
    total_raw = len(raw_rows)
    
    # ── CLEANING STEP 1A: Botanical Mass-Balance Ratio (Juice / Weight <= 0.60) ──
    # Peel, pith, membranes, and seeds must comprise >= 40% of calamansi mass.
    step1_rows = [r for r in raw_rows if (r[1] / r[0]) <= 0.60]
    removed_ratio = total_raw - len(step1_rows)
    
    # ── CLEANING STEP 1B: Textbook 98% Confidence Interval (|Z| <= 2.326) ──
    # Computes standard deviation within each integer gram weight group
    by_weight = {}
    for w, j in step1_rows:
        iw = int(round(w))
        by_weight.setdefault(iw, []).append(j)
        
    clean_rows = []
    for w, j in step1_rows:
        iw = int(round(w))
        group = by_weight[iw]
        mean = sum(group) / len(group)
        std = math.sqrt(sum((v - mean) ** 2 for v in group) / len(group)) if len(group) > 1 else 0
        if std == 0 or abs(j - mean) / std <= 2.326:
            clean_rows.append((w, j))
            
    removed_outliers = len(step1_rows) - len(clean_rows)
    
    return raw_rows, clean_rows, removed_ratio, removed_outliers

def solve_linear_system(A, b):
    """Gaussian elimination with partial pivoting (Pure Python OLS/Ridge solver)"""
    n = len(b)
    M = [A[i][:] + [b[i]] for i in range(n)]
    for i in range(n):
        max_row = max(range(i, n), key=lambda r: abs(M[r][i]))
        M[i], M[max_row] = M[max_row], M[i]
        pivot = M[i][i]
        for c in range(i, n + 1):
            M[i][c] /= pivot
        for r in range(n):
            if r != i:
                factor = M[r][i]
                for c in range(i, n + 1):
                    M[r][c] -= factor * M[i][c]
    return [M[i][-1] for i in range(n)]

def fit_ridge_normal_equation(X, y, alpha=0.0):
    """Computes beta = (X^T X + alpha * I)^(-1) X^T y"""
    k = len(X[0])
    n = len(X)
    XTX = [[sum(X[i][r] * X[i][c] for i in range(n)) for c in range(k)] for r in range(k)]
    for r in range(1, k):  # Do not regularize the bias/intercept
        XTX[r][r] += alpha
    XTy = [sum(X[i][r] * y[i] for i in range(n)) for r in range(k)]
    return solve_linear_system(XTX, XTy)

def evaluate_metrics(y_true, y_pred):
    n = len(y_true)
    mean_y = sum(y_true) / n
    ss_tot = sum((y - mean_y) ** 2 for y in y_true)
    ss_res = sum((y - p) ** 2 for y, p in zip(y_true, y_pred))
    
    r2 = (1.0 - (ss_res / ss_tot)) if ss_tot > 0 else 0.0
    mae = sum(abs(y - p) for y, p in zip(y_true, y_pred)) / n
    mse = ss_res / n
    rmse = math.sqrt(mse)
    mape = (sum(abs((y - p) / y) for y, p in zip(y_true, y_pred) if y > 0) / n) * 100.0
    
    return {
        'r2': round(r2, 4),
        'mae': round(mae, 4),
        'rmse': round(rmse, 4),
        'mse': round(mse, 4),
        'mape': round(mape, 2)
    }

