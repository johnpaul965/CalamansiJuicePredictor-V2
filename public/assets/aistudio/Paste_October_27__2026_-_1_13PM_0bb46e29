import 'dart:math';

class PredictionService {
  static const double representativeWeight = 12.686; // Mean fruit weight in grams

  // 1. Simple Linear Regression Baseline
  static double predictSLR(double w) {
    final val = 0.4162 * w - 0.0432;
    return val > 0 ? val : 0.0;
  }

  // 2. Polynomial Regression d=2 Baseline (No Size)
  static double predictPoly(double w) {
    final val = 2.1605 + 0.0419 * w + 0.01500 * (w * w);
    return val > 0 ? val : 0.0;
  }

  // 3. ★ Proposed Champion Model: Poly d=2 + ln(W) & L2 Ridge
  static double predictProposed(double w) {
    final logW = log(max(1.0, w));
    final val = 2.317885 + 1.100407 * w - 0.014151 * (w * w) - 3.445975 * logW;
    return val > 0 ? val : 0.0;
  }

  // Batch Calculation for Farmer
  static Map<String, dynamic> calculateBatch(double weightG) {
    final count = (weightG / representativeWeight).round();
    final countFloat = weightG / representativeWeight;
    
    final slrTotalMl = countFloat * predictSLR(representativeWeight);
    final polyTotalMl = countFloat * predictPoly(representativeWeight);
    final proposedTotalMl = countFloat * predictProposed(representativeWeight);

    return {
      'count': count,
